4.452165Z","iopub.status.busy":"2026-11-18T15:57:54.45191Z","iopub.status.idle":"2026-11-18T15:57:54.473566Z","shell.execute_reply":"2026-11-18T15:57:54.472891Z"},"papermill":{"duration":0.028931,"end_time":"2026-11-18T15:57:54.47525","exception":false,"start_time":"2026-11-18T15:57:54.446319","status":"completed"},"tags":[]},"outputs":[],"source":["def log_section(t): print(f\"\\n{'=' * 78}\\n {t}\\n{'=' * 78}\")\n","def log_info(m):    print(f\"[INFO] {m}\")\n","def log_ok(m):      print(f\"[OK]   {m}\")\n","def log_warn(m):    print(f\"[WARN] {m}\")\n","\n","\n","def get_secret(name):\n","    v = os.environ.get(name)\n","    if v:\n","        return v\n","    try:\n","        from kaggle_secrets import UserSecretsClient\n","        return UserSecretsClient().get_secret(name)\n","    except Exception:\n","        return None\n","\n","\n","class HTTPFatal(Exception):\n","    pass\n","\n","\n","SESSION = requests.Session()\n","SESSION.headers['User-Agent'] = 'bnt-v2-research/1.0 (PGDPLAT-UFSJ)'\n","_HTTP_RNG = np.random.default_rng(42)          # v2.3: jitter determinístico dos reintentos\n","\n","\n","def http_get(url, params=None, timeout=60, retries=4, backoff=6, stream=False):\n","    \"\"\"v2.3: GET com nova tentativa para erros transitórios (rede, 429, 5xx), respeitando Retry-After,\n","    com backoff exponencial (teto de 300 s) e jitter de ±25% para não sincronizar consultas.\"\"\"\n","    last = None\n","    for a in range(retries):\n","        try:\n","            r = SESSION.get(url, params=params, timeout=timeout, stream=stream)\n","        except requests.RequestException as e:\n","            last = e\n","            time.sleep(min(backoff * 2 ** a, 300))\n","            continue\n","        if r.status_code == 429 or r.status_code >= 500:\n","            last = f'HTTP {r.status_code}'\n","            wait = None\n","            ra = r.headers.get('Retry-After')\n","            if ra:\n","                try:\n","                    wait = float(ra)\n","                except ValueError:\n","                    try:      # HTTP-date\n","                        wait = (datetime.strptime(ra, '%a, %d %b %Y %H:%M:%S GMT').replace(tzinfo=timezone.utc)\n","                                - datetime.now(timezone.utc)).total_seconds()\n","                    except Exception:\n","                        wait = None\n","            base = wait if wait is not None else backoff * 2 ** a\n","            pause = min(max(base, 1.0), 300.0) * float(0.75 + 0.5 * _HTTP_RNG.random())\n","            log_warn(f'HTTP {r.status_code} — aguardando {pause:.0f}s antes da tentativa {a + 2}/{retries}')\n","            time.sleep(pause)\n","            continue\n","        if r.status_code >= 400:\n","            raise HTTPFatal(f'HTTP {r.status_code} — {url}')\n","        return r\n","    raise HTTPFatal(f'falhou após {retries} tentativas ({last}) — {url}')\n","\n","\n","def download(url, dest, max_age_days=None, chunk=1 << 20):\n","    dest = Path(dest)\n","    if dest.exists() and dest.stat().st_size > 0:\n","        age = (time.time() - dest.stat().st_mtime) / 86400\n","        if max_age_days is None or age <= max_age_days:\n","            return dest\n","    dest.parent.mkdir(parents=True, exist_ok=True)\n","    tmp = dest.with_name(dest.name + '.part')\n","    r = http_get(url, stream=True, timeout=600)\n","    with open(tmp, 'wb') as f:\n","        for b in r.iter_content(chunk):\n","            f.write(b)\n","    tmp.replace(dest)\n","    return dest\n","\n","\n","def strip_accents(s):\n","    s = unicodedata.normalize('NFKD', str(s))\n","    return ''.join(c for c in s if not unicodedata.combining(c))\n","\n","\n","def norm_text(s):\n","    if s is None or (isinstance(s, float) and np.isnan(s)):\n","        return ''\n","    return re.sub(r'\\s+', ' ', strip_accents(s).lower()).strip()\n","\n","\n","def ym_of(dates):\n","    \"\"\"Índice absoluto de mês: ano*12 + mês-1.\"\"\"\n","    d = pd.to_datetime(dates, errors='coerce')\n","    return (d.dt.year * 12 + d.dt.month - 1).astype('float')\n","\n","\n","def ym_label(ym):\n","    ym = int(ym)\n","    return f'{ym // 12}-{ym % 12 + 1:02d}'\n","\n","\n","def rolling_sum(X, w, axis=2):\n","    \"\"\"Soma móvel de w períodos terminando em t (inclusive), ao longo de `axis`.\"\"\"\n","    cs = np.cumsum(X, axis=axis, dtype=np.float64)\n","    out = cs.copy()\n","    hi = [slice(None)] * X.ndim\n","    lo = [slice(None)] * X.ndim\n","    hi[axis] = slice(w, None)\n","    lo[axis] = slice(None, -w)\n","    out[tuple(hi)] = cs[tuple(hi)] - cs[tuple(lo)]\n","    return out\n","\n","\n","def months_since_last(X, cap=240):\n","    T = X.shape[2]\n","    t = np.arange(T)[None, None, :]\n","    last = np.maximum.accumulate(np.where(X > 0, t, -1), axis=2)\n","    return np.minimum(np.where(last >= 0, t - last, cap), cap).astype(np.float32)\n","\n","\n","def signed_log1p(x):\n","    return np.sign(x) * np.log1p(np.abs(x))\n","\n","\n","def ym_parse(s):\n","    y, m = map(int, str(s).split('-'))\n","    return y * 12 + m - 1\n","\n","\n","PROVENANCE = {}\n","EXCLUSIONS = {}\n","\n","\n","def sha256_of(path, chunk=1 << 22):\n","    h = hashlib.sha256()\n","    with open(path, 'rb') as f:\n","        for b in iter(lambda: f.read(chunk), b''):\n","            h.update(b)\n","    return h.hexdigest()\n","\n","\n","def register_source(name, path=None, url=None, **extra):\n","    rec = {'url': url, 'registrado_em': datetime.now(timezone.utc).isoformat(timespec='seconds'), **extra}\n","    if path is not None and Path(path).exists():\n","        p = Path(path)\n","        rec.update(arquivo=str(p), bytes=p.stat().st_size, sha256=sha256_of(p),\n","                   modificado_em=datetime.fromtimestamp(p.stat().st_mtime, timezone.utc).isoformat(timespec='seconds'))\n","    PROVENANCE[name] = rec\n","\n","\n","def snapshot_path(cfg, name):\n","    d = cfg.OUT / 'snapshot'\n","    d.mkdir(parents=True, exist_ok=True)\n","    return d / name\n","\n","\n","def replay_path(cfg, name):\n","    if not cfg.REPLAY_FROM:\n","        return None\n","    p = Path(cfg.REPLAY_FROM) / name\n","    if not p.exists():\n","        raise FileNotFoundError(f'REPLAY_FROM sem {name}: {p}')\n","    return p\n","\n","\n","def to_parquet_safe(df, path):\n","    df.astype({c: str for c in df.columns if df[c].dtype == object}).to_parquet(path, index=False)"]},{"cell_type":"code","execution_count":4,"id":"1a13b498","metadata":{"execution":{"iopub.execute_input":"2026-11-18T15:57:54.488008Z","iopub.status.busy":"2026-11-18T15:57:54.487802Z","iopub.status.idle":"2026-11-18T15:57:54.509863Z","shell.execute_reply":"2026-11-18T15:57:54.509309Z"},"papermill":{"duration":0.030398,"end_time":"2026-11-18T15:57:54.511201","exception":false,"start_time":"2026-11-18T15:57:54.480803","status":"completed"},"tags":[]},"outputs":[],"source":["HS_SECTIONS = {\n","    'I':     (1, 5,   'Animais vivos e produtos animais'),\n","    'II':    (6, 14,  'Produtos vegetais'),\n","    'III':   (15, 15, 'Gorduras e óleos'),\n","    'IV':    (16, 24, 'Alimentos, bebidas e fumo'),\n","    'V':     (25, 27, 'Produtos minerais'),\n","    'VI':    (28, 38, 'Químicos'),\n","    'VII':   (39, 40, 'Plásticos e borracha'),\n","    'VIII':  (41, 43, 'Couros e peles'),\n","    'IX':    (44, 46, 'Madeira'),\n","    'X':     (47, 49, 'Celulose e papel'),\n","    'XI':    (50, 63, 'Têxteis'),\n","    'XII':   (64, 67, 'Calçados e chapéus'),\n","    'XIII':  (68, 70, 'Pedra, cerâmica e vidro'),\n","    'XIV':   (71, 71, 'Metais e pedras preciosas'),\n","    'XV':    (72, 83, 'Metais comuns'),\n","    'XVI':   (84, 85, 'Máquinas e elétricos'),\n","    'XVII':  (86, 89, 'Material de transporte'),\n","    'XVIII': (90, 92, 'Instrumentos'),\n","    'XIX':   (93, 93, 'Armas e munições'),\n","    'XX':    (94, 96, 'Manufaturados diversos'),\n","    'XXI':   (97, 97, 'Obras de arte'),\n","}\n","CHAPTER_TO_SECTION = {f'{c:02d}': s for s, (a, b, _) in HS_SECTIONS.items() for c in range(a, b + 1) if c != 